[configuration]

entry_symbol = "codigo_critico_init"
compatibility_minimum = "4.3"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libcodigocritico.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libcodigocritico.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libcodigocritico.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libcodigocritico.windows.template_release.x86_64.dll"
